@echo off
setlocal EnableExtensions EnableDelayedExpansion
cd /d "%~dp0"
title Aeternum STATUS

echo(
echo === Aeternum Engine - STATUS ===
echo Runtime folder: %CD%
echo(
call :read_conf_int "bnetserver.conf" "BattlenetPort" BN_PORT
call :read_conf_int "bnetserver.conf" "LoginREST.Port" REST_PORT
call :read_conf_int "worldserver.conf" "WorldServerPort" WORLD_PORT
if "!BN_PORT!"=="" set BN_PORT=2119
if "!REST_PORT!"=="" set REST_PORT=18083
if "!WORLD_PORT!"=="" set WORLD_PORT=18085

echo Ports (from conf):
call :port_line Battlenet !BN_PORT!
call :port_line LoginREST !REST_PORT!
call :port_line World     !WORLD_PORT!
echo(
echo Processes under this folder:
call :show_proc bnetserver
call :show_proc worldserver
echo(
if defined AETERNUM_HEALTH_TOKEN (
  echo Health token env AETERNUM_HEALTH_TOKEN is set - probing LoginREST on port !REST_PORT! ...
  powershell -NoProfile -Command "$p=@args[0]; $t=$env:AETERNUM_HEALTH_TOKEN; try { $r=Invoke-WebRequest -Uri ('https://127.0.0.1:'+$p+'/') -SkipCertificateCheck -Headers @{Authorization=('Bearer '+$t)} -TimeoutSec 5; Write-Host ('  HTTP '+[int]$r.StatusCode) } catch { Write-Host ('  health probe failed: '+$_.Exception.Message) }" !REST_PORT!
) else (
  echo Health: skipped - set env AETERNUM_HEALTH_TOKEN to enable optional probe.
)
echo(
exit /b 0

:port_line
set "_lbl=%~1"
set "_p=%~2"
powershell -NoProfile -Command "try { if(Get-NetTCPConnection -LocalPort %_p% -State Listen -ErrorAction Stop){ Write-Host ('  %_lbl% port %_p%: LISTEN') } else { Write-Host ('  %_lbl% port %_p%: not listening') } } catch { Write-Host ('  %_lbl% port %_p%: not listening') }"
goto :eof

:show_proc
set "_proc=%~1"
set "_found=0"
for /f "usebackq tokens=1,2 delims=|" %%A in (`powershell -NoProfile -Command "$here='%~dp0'.TrimEnd('\'); Get-Process -Name '%_proc%' -ErrorAction SilentlyContinue | Where-Object { $_.Path -and $_.Path.StartsWith($here,[StringComparison]::OrdinalIgnoreCase) } | ForEach-Object { $_.Id.ToString() + '|' + $_.Path }"`) do (
  echo   %_proc%.exe PID=%%A
  echo           %%B
  set "_found=1"
)
if "!_found!"=="0" echo   %_proc%.exe: not running from this folder
goto :eof

:read_conf_int
set "_file=%~1"
set "_key=%~2"
set "_out=%~3"
set "%_out%="
if not exist "%_file%" goto :eof
for /f "usebackq tokens=1,* delims==" %%A in (`findstr /R /C:"^%_key% *=" "%_file%" 2^>nul`) do (
  set "_val=%%B"
  set "_val=!_val: =!"
  set "_val=!_val:"=!"
  set "%_out%=!_val!"
  goto :eof
)
goto :eof


